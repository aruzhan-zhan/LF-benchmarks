target C {
    timeout: 5 sec,
    fast: false
}

preamble {=
    #include <math.h>
    #include <string.h>

    // MPC parameters
    #define NX      2        
    #define NU      1        
    #define HORIZON 10      
    #define DT      0.001    
    #define OPT_ITER 50      
    #define OPT_LR   0.01 

    // Cost weights
    #define Q_POS   10.0     
    #define Q_VEL   1.0                         
    #define R_INPUT 0.1

    // Input saturation
    #define U_MAX   5.0
    #define U_MIN  -5.0

    // Linear system matrices
    static const double A[NX][NX] = {
        {1.0, DT },
        {0.0, 1.0}
    };
    static const double B[NX][NU] = {
        {0.5 * DT * DT},
        {DT           }
    };

    // Created struct to pass state across LF ports
    typedef struct {
        double data[NX];
    } state_t; 

    // Reference reactor (Reactor thread)
    reactor Reference{
        output x_ref: state_t

        timer t1(1 sec)
        timer t2(3 sec)

        reaction(startup) -> x_ref {=
            state_t ref = {{0.0, 0.0}};
            lf_set(x_ref, ref);
        =}

        reaction(t1) -> x_ref {=
            state_t ref = {{1.0, 0.0}};
            lf_set(x_ref, ref);
            printf("[ref    ] reference -> 1.0\n");
        =}

        reaction(t2) -> x_ref {=
            state_t ref = {{0.5, 0.0}};
            lf_set(x_ref, ref);
            printf("[ref    ] reference -> 0.5\n");
        =}
    }
=}