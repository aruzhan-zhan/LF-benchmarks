target C {
    timeout: 5 sec,
    build-type: Release
}

preamble {=
    #include <math.h>
    #include <string.h>

    // MPC parameters
    #define NX      2        
    #define NU      1        
    #define HORIZON 10      
    #define DT      0.001    
    #define OPT_ITER 50      
    #define OPT_LR   0.01 

    // Cost weights
    #define Q_POS   10.0     
    #define Q_VEL   1.0                             
    #define R_INPUT 0.1

    // Input saturation
    #define U_MAX   5.0
    #define U_MIN  -5.0

    // Linear system matrices
    static const double A[NX][NX] = {
        {1.0, DT },
        {0.0, 1.0}
    };
    static const double B[NX][NU] = {
        {0.5 * DT * DT},
        {DT           }
    };

    // Created struct to pass state across LF ports
    typedef struct {
        double data[NX];
    } state_t; 

    // C math function for Gradient Descent
    static double compute_cost(const double x0[NX], const double xref[NX], const double u_seq[HORIZON][NU])
    {
        double cost = 0.0;
        double x[NX];
        memcpy(x, x0, NX * sizeof(double));

        for (int k = 0; k < HORIZON; k++) {
            /* State cost */
            double ex[NX];
            for (int i = 0; i < NX; i++) ex[i] = x[i] - xref[i];
            cost += Q_POS * ex[0]*ex[0] + Q_VEL * ex[1]*ex[1];

            /* Input cost */
            for (int j = 0; j < NU; j++) cost += R_INPUT * u_seq[k][j] * u_seq[k][j];

            /* Propagate */
            double xn[NX] = {0};
            for (int i = 0; i < NX; i++) {
                for (int j = 0; j < NX; j++) xn[i] += A[i][j]*x[j];
                for (int j = 0; j < NU; j++) xn[i] += B[i][j]*u_seq[k][j];
            }
            memcpy(x, xn, sizeof(x));
        }
        /* Terminal cost */
        double ex[NX];
        for (int i = 0; i < NX; i++) ex[i] = x[i] - xref[i];
        cost += 10.0 * Q_POS * ex[0]*ex[0] + 10.0 * Q_VEL * ex[1]*ex[1];

        return cost;
    }
=}

// Reference reactor (Remote Control)
reactor Reference {
    output x_ref: state_t

    timer t1(1 sec)
    timer t2(3 sec)

    reaction(startup) -> x_ref {=
        state_t ref = {{0.0, 0.0}};
        lf_set(x_ref, ref);
    =}

    reaction(t1) -> x_ref {=
        state_t ref = {{1.0, 0.0}};
        lf_set(x_ref, ref);
        printf("[ref    ] reference -> 1.0\n");
    =}

    reaction(t2) -> x_ref {=
        state_t ref = {{0.5, 0.0}};
        lf_set(x_ref, ref);
        printf("[ref    ] reference -> 0.5\n");
    =}
}

// SENSOR REACTOR (Reads the simulated environment)
reactor Sensor {
    input true_physics: state_t
    output x: state_t
    state tick: long = 0

    // Triggers whenever the environment state arrives (no timer needed)
    reaction(true_physics) -> x {=
        double noise = 0.0001 * sin((double)self->tick*0.37);
        state_t current_x;
        current_x.data[0] = true_physics->value.data[0] + noise;
        current_x.data[1] = true_physics->value.data[1] + noise*0.5;

        lf_set(x, current_x);
        self->tick++;
    =}
}

// ACTUATOR REACTOR (Applies forces and simulated physics)
reactor Actuator {
    input u: double
    output true_physics: state_t
    
    state plant_x: double[] = {0.0, 0.0}
    state tick: long = 0

    // start the simulation loop at exactly T=0
    reaction(startup) -> true_physics {=
        state_t init_state = {{self->plant_x[0], self->plant_x[1]}};
        lf_set(true_physics, init_state);
    =}

    // Receives voltage, updates physics, and sends the new physical state
    reaction(u) -> true_physics {=
        double u_val = u->value;
        double x_new[NX];

        // Apply physics matrix math
        x_new[0] = A[0][0]*self->plant_x[0] + A[0][1]*self->plant_x[1] + B[0][0]*u_val;
        x_new[1] = A[1][0]*self->plant_x[0] + A[1][1]*self->plant_x[1] + B[1][0]*u_val;

        self->plant_x[0] = x_new[0];
        self->plant_x[1] = x_new[1];

        if (self->tick % 500 == 0) {
            printf("[actuate] tick=%4ld | pos=%.4f | vel=%.4f | u=%.4f\n",
                   self->tick, self->plant_x[0], self->plant_x[1], u_val);
        }
        self->tick++;

        // Broadcast the new physical state to the Sensor
        state_t next_state = {{x_new[0], x_new[1]}};
        lf_set(true_physics, next_state);
    =}
}

reactor Optimizer {
    input x_current: state_t 
    input x_ref_in: state_t 
    output u_apply: double 

    state current_ref: double[] = {0.0, 0.0}

    reaction(x_ref_in) {=
        self->current_ref[0] = x_ref_in->value.data[0];
        self->current_ref[1] = x_ref_in->value.data[1];
    =}

    reaction(x_current) -> u_apply {=
        double x0[NX];
        x0[0] = x_current->value.data[0];
        x0[1] = x_current->value.data[1];

        double xref[NX];
        xref[0] = self->current_ref[0];
        xref[1] = self->current_ref[1];

        static double u_seq[HORIZON][NU] = {0};
        double eps = 1e-5;

        for (int iter = 0; iter < OPT_ITER; iter++) {
            for (int k = 0; k < HORIZON; k++) {
                for (int j = 0; j < NU; j++) {
                    double u_p[HORIZON][NU], u_m[HORIZON][NU];
                    memcpy(u_p, u_seq, sizeof(u_seq));
                    memcpy(u_m, u_seq, sizeof(u_seq));
                    u_p[k][j] += eps;
                    u_m[k][j] -= eps;

                    double grad = (compute_cost(x0, xref, u_p) -
                                   compute_cost(x0, xref, u_m)) / (2.0*eps);

                    u_seq[k][j] -= OPT_LR * grad;

                    if (u_seq[k][j] > U_MAX) u_seq[k][j] = U_MAX;
                    if (u_seq[k][j] < U_MIN) u_seq[k][j] = U_MIN;
                }
            }
        }

        lf_set(u_apply, u_seq[0][0]);

        for (int k = 0; k < HORIZON - 1; k++){
            memcpy(u_seq[k], u_seq[k+1], NU * sizeof(double));
        }
        memset(u_seq[HORIZON-1], 0, NU * sizeof(double));
    =} deadline(1 msec) {=
        printf("[WARNING] Optimizer missed 1ms deadline! Applying emergency brakes.\n");
        lf_set(u_apply, 0.0);
    =}
}

federated reactor {
    ref = new Reference()
    sensor = new Sensor()
    actuator = new Actuator()
    optimizer = new Optimizer()
    
    // The core control loop
    ref.x_ref -> optimizer.x_ref_in
    sensor.x -> optimizer.x_current
    optimizer.u_apply -> actuator.u

    // The simulated environment feedback loop
    // The delay replaces the timer and simulates exactly 1ms of physical time passing
    actuator.true_physics -> sensor.true_physics after 1 msec
}
